# Booking planning (server only)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# Isolated execution (server only)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# JWT authentication can be used instead of DAYTONA_API_KEY.
DAYTONA_JWT_TOKEN=
DAYTONA_ORGANIZATION_ID=
# Keep disabled in hosted environments. Local development can read a private CLI profile.
DAYTONA_ALLOW_LOCAL_CONFIG=0

# Tracing and evaluation (server only)
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=Book Your Girlfriend

# CopilotKit Intelligence
COPILOTKIT_LICENSE_KEY=
NEXT_PUBLIC_COPILOTKIT_LICENSE_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# Spoken booking briefings (server only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Public deployment metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Process-local cost guard, clamped to 1..3.
BOOKING_MAX_CONCURRENCY=1
